# LifeOps deployment settings.
#
# These are DEPLOYMENT settings only — where the database lives, what to bind.
# Provider credentials (DeepSeek, ElevenLabs, Telegram, calendar, email) are
# NOT configured here. Those are set in LifeOps Console after deployment and
# stored encrypted outside this repository. See CONFIGURATION.md.
#
# Copy to .env and adjust. .env is gitignored.

# --- NornicDB ---------------------------------------------------------------
# scripts/nornicdb.sh generates the password into
# ~/.local/share/lifeops/nornicdb.env on first start, and make/dev.sh source it
# automatically. Set it here only if you run NornicDB some other way.
LIFEOPS_NORNIC_URI=bolt://127.0.0.1:7687
LIFEOPS_NORNIC_USER=admin
# LIFEOPS_NORNIC_PASSWORD=

# --- LifeOps Core -----------------------------------------------------------
# Loopback by default. LifeOps holds a person's private world and has no
# authentication yet — do not bind it to a routable address. See SECURITY.md.
LIFEOPS_HTTP_HOST=127.0.0.1
LIFEOPS_HTTP_PORT=8080

# Where durable state lives: secrets, configuration, logs.
# LIFEOPS_STATE_DIR=~/.local/share/lifeops

LIFEOPS_LOG_LEVEL=INFO
LIFEOPS_LOG_JSON=true

# Boot with external actions blocked (BUILD_SPEC section 83).
LIFEOPS_SAFE_MODE=false

# --- Console ----------------------------------------------------------------
# VITE_LIFEOPS_URL=http://127.0.0.1:8080
# VITE_LIFEOPS_PORT=8080
