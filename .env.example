# Top-level .env loaded by docker-compose. Per-service config lives in
# backend/.env.example and frontend/.env.example.

# -----------------------------------------------------------------------------
# Docker Compose port mappings
# -----------------------------------------------------------------------------
FRONTEND_PORT=3010
BACKEND_PORT=8010
QDRANT_HTTP_PORT=6335
QDRANT_GRPC_PORT=6336

# -----------------------------------------------------------------------------
# Optional OpenClaw integration
# -----------------------------------------------------------------------------
OPENCLAW_URL=http://host.docker.internal:18789
OPENCLAW_TOKEN=

# -----------------------------------------------------------------------------
# E2E suite (override only if your stack runs on non-default ports)
# -----------------------------------------------------------------------------
# E2E_FRONTEND_URL=http://localhost:5173
# E2E_BACKEND_URL=http://localhost:8000
# E2E_TEST_EMAIL=e2e@knowledge-os.local
# E2E_TEST_USERNAME=e2etester
# E2E_TEST_PASSWORD=e2eTestPass!23
