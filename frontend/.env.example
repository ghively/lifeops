# Knowledge OS — Frontend environment variables
# Copy this file to .env.local and fill in the values.

# Backend API URL (leave empty to use same origin / proxy)
VITE_API_URL=

# Backend proxy port for dev server
VITE_DEV_BACKEND_PORT=8010

# Set to "true" to disable minification and enable sourcemaps in builds
VITE_DEV_BUILD=
