# =============================================================================
# Knowledge OS Backend Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0                          # str   - Bind address
PORT=8000                              # int   - Bind port
DEBUG=false                           # bool  - Enable debug mode

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost                  # str   - Qdrant host
QDRANT_PORT=6333                       # int   - Qdrant HTTP port
QDRANT_API_KEY=                        # str   - Optional API key

# -----------------------------------------------------------------------------
# SQLite Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///backend/data/knowledge_os.db  # str - SQLAlchemy connection URL

# -----------------------------------------------------------------------------
# OpenClaw Gateway
# -----------------------------------------------------------------------------
OPENCLAW_URL=http://localhost:18789     # str   - Gateway URL (alias)
OPENCLAW_GATEWAY_URL=http://localhost:18789  # str - Gateway URL (primary)
OPENCLAW_TOKEN=                        # str   - Gateway auth token (alias)
OPENCLAW_GATEWAY_TOKEN=                # str   - Gateway auth token (primary)
OPENCLAW_ENABLED=true                  # bool  - Enable OpenClaw integration

# -----------------------------------------------------------------------------
# LLM Provider (Agent Runtime)
# -----------------------------------------------------------------------------
# Default provider for agent chat. Auto-configured for Ollama.
# Override per-agent in TOOLS.md.
LLM_PROVIDER=ollama                    # str   - ollama | openai | anthropic | google
LLM_MODEL=qwen2.5-coder:7b            # str   - Default model
LLM_BASE_URL=                          # str   - Override API base URL (auto-detected for ollama)
LLM_API_KEY=                           # str   - API key (not needed for Ollama)
LLM_TEMPERATURE=0.2                    # float - Default temperature
LLM_MAX_TOKENS=2048                    # int   - Default max response tokens

# -----------------------------------------------------------------------------
# AI / Context
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2       # str   - Text embedding model
CLIP_MODEL=openai/clip-vit-base-patch32  # str - Image embedding model
MAX_CONTEXT_TOKENS=4000                # int   - Max context for agents

# -----------------------------------------------------------------------------
# Storage Paths
# -----------------------------------------------------------------------------
DATA_DIR=backend/data                  # str   - Base data directory
BACKUP_PATH=backend/backups            # str   - Backup output directory
HEARTBEAT_PATH=backend/HEARTBEAT.md    # str   - Heartbeat file path
WATCHED_FOLDERS_PATH=backend/data/watched_folders.json  # str - Watched folders config
MAX_FILE_SIZE_MB=50                    # int   - Max file size to index

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true                    # bool  - Enable backups
SNAPSHOT_INTERVAL_HOURS=24             # int   - Snapshot frequency in hours
MARKDOWN_EXPORT_ENABLED=true           # bool  - Enable markdown export
MARKDOWN_EXPORT_PATH=./backups/markdown  # str - Markdown export path
GIT_BACKUP_ENABLED=false               # bool  - Enable Git backup sync

# -----------------------------------------------------------------------------
# Git Sync
# -----------------------------------------------------------------------------
GIT_REPO_URL=                          # str   - Git repo URL for backup sync

# -----------------------------------------------------------------------------
# JWT / Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=                        # str   - Secret for signing JWTs (set in production!)
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # int   - Access token TTL (default 24h)
REFRESH_TOKEN_EXPIRE_DAYS=7            # int   - Refresh token TTL (default 7 days)
RESET_TOKEN_EXPIRE_HOURS=1             # int   - Password-reset token TTL (default 1h)

# -----------------------------------------------------------------------------
# CORS / Logging
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173  # str - Comma-separated allowed origins
LOG_LEVEL=INFO                         # str   - DEBUG | INFO | WARNING | ERROR
