# =============================================================================
# Knowledge OS Backend Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0                          # str   - Bind address
PORT=8000                              # int   - Bind port

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost                  # str   - Qdrant host
QDRANT_PORT=6333                       # int   - Qdrant HTTP port
QDRANT_API_KEY=                        # str   - Optional API key

# -----------------------------------------------------------------------------
# SQLite Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///backend/data/knowledge_os.db  # str - SQLAlchemy connection URL

# -----------------------------------------------------------------------------
# OpenClaw Gateway
# -----------------------------------------------------------------------------
OPENCLAW_URL=http://localhost:18789     # str   - Gateway URL (alias)
OPENCLAW_GATEWAY_URL=                  # str   - Gateway URL (primary)
OPENCLAW_TOKEN=                        # str   - Gateway auth token (alias)
OPENCLAW_GATEWAY_TOKEN=                # str   - Gateway auth token (primary)

# -----------------------------------------------------------------------------
# Storage Paths
# -----------------------------------------------------------------------------
DATA_DIR=backend/data                  # str   - Base data directory
BACKUP_PATH=backend/backups            # str   - Backup output directory
HEARTBEAT_PATH=backend/HEARTBEAT.md    # str   - Heartbeat file path
WATCHED_FOLDERS_PATH=backend/data/watched_folders.json  # str - Watched folders config

# -----------------------------------------------------------------------------
# Git Sync
# -----------------------------------------------------------------------------
GIT_REPO_URL=                          # str   - Git repo URL for backup sync

# -----------------------------------------------------------------------------
# JWT / Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=                        # str   - Secret for signing JWTs (set in production!)
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # int   - Access token TTL (default 24h)
REFRESH_TOKEN_EXPIRE_DAYS=7            # int   - Refresh token TTL (default 7 days)
RESET_TOKEN_EXPIRE_HOURS=1             # int   - Password-reset token TTL (default 1h)

# -----------------------------------------------------------------------------
# CORS / Logging
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173  # str - Comma-separated allowed origins
LOG_LEVEL=INFO                         # str   - DEBUG | INFO | WARNING | ERROR
